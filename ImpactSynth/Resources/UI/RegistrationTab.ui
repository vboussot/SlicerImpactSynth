<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
  <class>RegistrationTabWidget</class>

  <widget class="qMRMLWidget" name="RegistrationTabWidget">
    <layout class="QFormLayout" name="formLayout_registration">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <property name="horizontalSpacing"><number>4</number></property>
      <property name="verticalSpacing"><number>2</number></property>

      <!-- Preset -->
      <item row="0" column="0">
        <widget class="QLabel" name="label_preset">
          <property name="text"><string>Preset</string></property>
        </widget>
      </item>
      <item row="0" column="1">
        <layout class="QHBoxLayout" name="impactPresetRow">
          <property name="leftMargin"><number>0</number></property>
          <property name="topMargin"><number>0</number></property>
          <property name="rightMargin"><number>0</number></property>
          <property name="bottomMargin"><number>0</number></property>
          <property name="spacing"><number>4</number></property>

          <item>
            <widget class="QComboBox" name="impactPresetCombo">
              <property name="toolTip"><string>Select an IMPACT registration preset</string></property>
              <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Fixed"/></property>
            </widget>
          </item>
          <item>
            <widget class="QPushButton" name="impactPresetManagerButton">
              <property name="text"><string>Preset Manager</string></property>
              <property name="autoDefault"><bool>false</bool></property>
              <property name="default"><bool>false</bool></property>
              <property name="maximumSize"><size><width>140</width><height>24</height></size></property>
              <property name="minimumSize"><size><width>120</width><height>24</height></size></property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- Output transform -->
      <item row="1" column="0">
        <widget class="QLabel" name="label_outputTransform">
          <property name="text"><string>Output transform</string></property>
        </widget>
      </item>
      <item row="1" column="1">
        <layout class="QHBoxLayout" name="impactRow">
          <property name="leftMargin"><number>0</number></property>
          <property name="topMargin"><number>0</number></property>
          <property name="rightMargin"><number>0</number></property>
          <property name="bottomMargin"><number>0</number></property>
          <property name="spacing"><number>4</number></property>

          <item>
            <widget class="qMRMLNodeComboBox" name="impactTransformSelector">
              <property name="toolTip"><string>Select or create the output Transform</string></property>
              <property name="nodeTypes"><stringlist><string>vtkMRMLTransformNode</string></stringlist></property>
              <property name="addEnabled"><bool>true</bool></property>
              <property name="removeEnabled"><bool>true</bool></property>
              <property name="noneEnabled"><bool>true</bool></property>
              <property name="selectNodeUponCreation"><bool>true</bool></property>
              <property name="renameEnabled"><bool>true</bool></property>
              <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Fixed"/></property>
            </widget>
          </item>
        </layout>
      </item>

    </layout>
  </widget>

  <!-- Connexions MRML -->
  <connections>
    <connection>
      <sender>RegistrationTabWidget</sender>
      <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
      <receiver>impactTransformSelector</receiver>
      <slot>setMRMLScene(vtkMRMLScene*)</slot>
    </connection>
  </connections>

  <!-- Custom widgets -->
  <customwidgets>
    <customwidget>
      <class>qMRMLNodeComboBox</class>
      <extends>QWidget</extends>
      <header>qMRMLWidgets/qMRMLNodeComboBox.h</header>
    </customwidget>
  </customwidgets>

  <!-- Ressources (ajoue ton .qrc si tu utilises des icônes ici) -->
  <resources/>
</ui>
