<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
  <class>QualityTabWidget</class>

  <widget class="qMRMLWidget" name="QualityTabWidget">
    <layout class="QVBoxLayout" name="vLayout_qualityRoot" >
      <item>
        <widget class="QTabWidget" name="qaTabWidget">

          <!-- ===================== Onglet : Avec référence ===================== -->
          <widget class="QWidget" name="withRefTab">
            <attribute name="title"><string>With reference</string></attribute>
            <layout class="QFormLayout" name="formLayout_qa_ref">
              <property name="horizontalSpacing"><number>8</number></property>
              <property name="verticalSpacing"><number>4</number></property>

              <!-- sCT volume -->
              <item row="0" column="0"><widget class="QLabel" name="label_sCTVolume"><property name="text"><string>sCT volume</string></property></widget></item>
              <item row="0" column="1">
                <widget class="qMRMLNodeComboBox" name="sCTVolumeSelector">
                  <property name="nodeTypes"><stringlist><string>vtkMRMLScalarVolumeNode</string></stringlist></property>
                  <property name="noneEnabled"><bool>true</bool></property>
                </widget>
              </item>

              <!-- Reference volume -->
              <item row="1" column="0"><widget class="QLabel" name="label_refVolume"><property name="text"><string>Reference volume</string></property></widget></item>
              <item row="1" column="1">
                <widget class="qMRMLNodeComboBox" name="referenceVolumeSelector">
                  <property name="nodeTypes"><stringlist><string>vtkMRMLScalarVolumeNode</string></stringlist></property>
                  <property name="noneEnabled"><bool>true</bool></property>
                </widget>
              </item>

              <!-- Reference mask -->
              <item row="2" column="0"><widget class="QLabel" name="label_refMask"><property name="text"><string>Mask (Optional)</string></property></widget></item>
              <item row="2" column="1">
                <widget class="qMRMLNodeComboBox" name="referenceMaskSelector">
                  <property name="nodeTypes"><stringlist><string>vtkMRMLLabelMapVolumeNode</string><string>vtkMRMLSegmentationNode</string></stringlist></property>
                  <property name="noneEnabled"><bool>true</bool></property>
                  <property name="noneDisplay"><string>None</string></property>
                </widget>
              </item>

              <item row="3" column="0"><widget class="QLabel" name="label_outputTransform"><property name="text"><string>Transform</string></property></widget></item>
              <item row="3" column="1">
                  <widget class="qMRMLNodeComboBox" name="impactTransformSelector">
                    <property name="nodeTypes"><stringlist><string>vtkMRMLTransformNode</string></stringlist></property>
                    <property name="noneEnabled"><bool>true</bool></property>
                    <property name="noneDisplay"><string>None</string></property>
                  </widget>
              </item>

   <!-- Metrics side by side -->
<item row="4" column="0" colspan="2">
  <layout class="QHBoxLayout" name="hLayout_metrics">
    <property name="spacing"><number>20</number></property>

    <!-- Image metrics -->
    <item>
      <widget class="QGroupBox" name="group_imageMetrics">
        <property name="title"><string>Image metrics</string></property>
        <layout class="QFormLayout" name="form_imageMetrics">
          <property name="horizontalSpacing"><number>12</number></property>
          <property name="verticalSpacing"><number>6</number></property>

          <!-- MAE -->
          <item row="0" column="0">
            <widget class="QLabel" name="label_mae">
              <property name="text"><string>MAE</string></property>
            </widget>
          </item>
          <item row="0" column="1">
            <layout class="QHBoxLayout" name="hMae">
              <item>
                <widget class="QLineEdit" name="maeValue">
                  <property name="readOnly"><bool>true</bool></property>
                  <property name="placeholderText"><string>–</string></property>
                  <property name="minimumWidth"><number>70</number></property>
                  <property name="maximumWidth"><number>80</number></property>
                  <property name="alignment"><set>Qt::AlignCenter</set></property>
                </widget>
              </item>
              <item>
                <widget class="QLabel" name="label_mae_unit">
                  <property name="text"><string>HU</string></property>
                </widget>
              </item>
            </layout>
          </item>

          <!-- PSNR -->
          <item row="1" column="0">
            <widget class="QLabel" name="label_psnr">
              <property name="text"><string>PSNR</string></property>
            </widget>
          </item>
          <item row="1" column="1">
            <layout class="QHBoxLayout" name="hPsnr">
              <item>
                <widget class="QLineEdit" name="psnrValue">
                  <property name="readOnly"><bool>true</bool></property>
                  <property name="placeholderText"><string>–</string></property>
                  <property name="minimumWidth"><number>70</number></property>
                  <property name="maximumWidth"><number>80</number></property>
                  <property name="alignment"><set>Qt::AlignCenter</set></property>
                </widget>
              </item>
              <item>
                <widget class="QLabel" name="label_psnr_unit">
                  <property name="text"><string>dB</string></property>
                </widget>
              </item>
            </layout>
          </item>

          <!-- SSIM -->
          <item row="2" column="0">
            <widget class="QLabel" name="label_ssim">
              <property name="text"><string>SSIM</string></property>
            </widget>
          </item>
          <item row="2" column="1">
            <widget class="QLineEdit" name="ssimValue">
              <property name="readOnly"><bool>true</bool></property>
              <property name="placeholderText"><string>–</string></property>
              <property name="minimumWidth"><number>70</number></property>
              <property name="maximumWidth"><number>80</number></property>
              <property name="alignment"><set>Qt::AlignCenter</set></property>
            </widget>
          </item>
        </layout>
      </widget>
    </item>

    <!-- Segmentation metrics -->
    <item>
      <widget class="QGroupBox" name="group_segMetrics">
        <property name="title"><string>Segmentation metrics</string></property>
        <layout class="QFormLayout" name="form_segMetrics">
          <property name="horizontalSpacing"><number>12</number></property>
          <property name="verticalSpacing"><number>6</number></property>

          <!-- Dice -->
          <item row="0" column="0">
            <widget class="QLabel" name="label_dice">
              <property name="text"><string>Dice</string></property>
            </widget>
          </item>
          <item row="0" column="1">
            <widget class="QLineEdit" name="diceValue">
              <property name="readOnly"><bool>true</bool></property>
              <property name="placeholderText"><string>–</string></property>
              <property name="minimumWidth"><number>70</number></property>
              <property name="maximumWidth"><number>80</number></property>
              <property name="alignment"><set>Qt::AlignCenter</set></property>
            </widget>
          </item>

          <!-- HD95 -->
          <item row="1" column="0">
            <widget class="QLabel" name="label_hd95">
              <property name="text"><string>HD95</string></property>
            </widget>
          </item>
          <item row="1" column="1">
            <layout class="QHBoxLayout" name="hHD95">
              <item>
                <widget class="QLineEdit" name="hd95Value">
                  <property name="readOnly"><bool>true</bool></property>
                  <property name="placeholderText"><string>–</string></property>
                  <property name="minimumWidth"><number>70</number></property>
                  <property name="maximumWidth"><number>80</number></property>
                  <property name="alignment"><set>Qt::AlignCenter</set></property>
                </widget>
              </item>
              <item>
                <widget class="QLabel" name="label_hd95_unit">
                  <property name="text"><string>mm</string></property>
                </widget>
              </item>
            </layout>
          </item>
        </layout>
      </widget>
    </item>
  </layout>
</item>

            </layout>
          </widget>

          <!-- ===================== Onglet : Sans référence ===================== -->
          <widget class="QWidget" name="noRefTab">
            <attribute name="title"><string>No reference (Uncertainty)</string></attribute>
            <layout class="QFormLayout" name="formLayout_qa_noref">
              <property name="horizontalSpacing"><number>8</number></property>
              <property name="verticalSpacing"><number>4</number></property>

              <item row="0" column="0"><widget class="QLabel" name="label_uncertainty"><property name="text"><string>Uncertainty</string></property></widget></item>
              <item row="0" column="1">
                <layout class="QHBoxLayout" name="hLayout_uncertaintyBtns">
                  <item><widget class="QPushButton" name="showErrorMapButton"><property name="text"><string>Show error map</string></property><property name="enabled"><bool>false</bool></property></widget></item>
                  <item><widget class="QPushButton" name="exportUncertaintyButton"><property name="text"><string>Export…</string></property><property name="enabled"><bool>false</bool></property></widget></item>
                </layout>
              </item>

              <item row="1" column="0"><widget class="QLabel" name="label_outputMap"><property name="text"><string>Output map</string></property></widget></item>
              <item row="1" column="1">
                <widget class="qMRMLNodeComboBox" name="uncertaintyOutputSelector">
                  <property name="nodeTypes"><stringlist><string>vtkMRMLScalarVolumeNode</string></stringlist></property>
                  <property name="noneEnabled"><bool>true</bool></property>
                  <property name="addEnabled"><bool>true</bool></property>
                  <property name="noneDisplay"><string>Create new on show</string></property>
                </widget>
              </item>

             <!-- Colonne unique: un groupbox qui contient les métriques -->
<item row="2" column="0" colspan="2">
  <widget class="QGroupBox" name="group_conformity">
    <property name="title">
      <string>Anatomical conformity metrics</string>
    </property>
    <layout class="QFormLayout" name="form_conformity">
      <property name="labelAlignment">
        <set>Qt::AlignRight|Qt::AlignVCenter</set>
      </property>
      <property name="formAlignment">
        <set>Qt::AlignLeft|Qt::AlignVCenter</set>
      </property>
      <property name="horizontalSpacing">
        <number>12</number>
      </property>
      <property name="verticalSpacing">
        <number>6</number>
      </property>

      <!-- Dice -->
      <item row="0" column="0">
        <widget class="QLabel" name="label_dice">
          <property name="text"><string>Dice</string></property>
        </widget>
      </item>
      <item row="0" column="1">
        <layout class="QHBoxLayout" name="hDice">
          <property name="spacing"><number>6</number></property>
          <item>
            <widget class="QLineEdit" name="diceValue">
              <property name="readOnly"><bool>true</bool></property>
              <property name="placeholderText"><string>–</string></property>
              <property name="minimumWidth"><number>70</number></property>
              <property name="maximumWidth"><number>80</number></property>
              <property name="alignment"><set>Qt::AlignCenter</set></property>
            </widget>
          </item>
        </layout>
      </item>

      <!-- HD95 -->
      <item row="1" column="0">
        <widget class="QLabel" name="label_hd95">
          <property name="text"><string>HD95</string></property>
        </widget>
      </item>
      <item row="1" column="1">
        <layout class="QHBoxLayout" name="hHD95">
          <property name="spacing"><number>6</number></property>
          <item>
            <widget class="QLineEdit" name="hd95Value">
              <property name="readOnly"><bool>true</bool></property>
              <property name="placeholderText"><string>–</string></property>
              <property name="minimumWidth"><number>70</number></property>
              <property name="maximumWidth"><number>80</number></property>
              <property name="alignment"><set>Qt::AlignCenter</set></property>
            </widget>
          </item>
          <item>
            <widget class="QLabel" name="label_hd95_unit">
              <property name="text"><string>mm</string></property>
            </widget>
          </item>
        </layout>
      </item>
    </layout>
  </widget>
</item>

            </layout>
          </widget>

        </widget>
      </item>
    </layout>
  </widget>

  <!-- Connexions MRML -->
  <connections>
  
    <connection>
      <sender>QualityTabWidget</sender>
      <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
      <receiver>sCTVolumeSelector</receiver>
      <slot>setMRMLScene(vtkMRMLScene*)</slot>
    </connection>
    <connection>
      <sender>QualityTabWidget</sender>
      <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
      <receiver>referenceVolumeSelector</receiver>
      <slot>setMRMLScene(vtkMRMLScene*)</slot>
    </connection>
    <connection>
      <sender>QualityTabWidget</sender>
      <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
      <receiver>referenceMaskSelector</receiver>
      <slot>setMRMLScene(vtkMRMLScene*)</slot>
    </connection>
    <connection>
      <sender>QualityTabWidget</sender>
      <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
      <receiver>uncertaintyOutputSelector</receiver>
      <slot>setMRMLScene(vtkMRMLScene*)</slot>
    </connection>
    <connection>
      <sender>QualityTabWidget</sender>
      <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
      <receiver>impactTransformSelector</receiver>
      <slot>setMRMLScene(vtkMRMLScene*)</slot>
    </connection>
  </connections>

  <!-- Custom widgets -->
  <customwidgets>
    <customwidget>
      <class>qMRMLNodeComboBox</class>
      <extends>QWidget</extends>
      <header>qMRMLWidgets/qMRMLNodeComboBox.h</header>
    </customwidget>
  </customwidgets>

  <resources/>
</ui>
